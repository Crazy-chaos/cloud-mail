# Cloudflare Worker Deployment Environment Variables
# Duplicate this file to .env and fill in your actual production values.
# Do NOT commit your .env file to public repositories!

# Required variables
ADMIN=your_admin_username_or_email
JWT_SECRET=your_super_secret_jwt_key
D1_DATABASE_ID=your_d1_database_uuid
KV_NAMESPACE_ID=your_kv_namespace_uuid
R2_BUCKET_NAME=your_r2_bucket_name

# Optional variables (Uncomment and set if needed)
# NAME=cloud-mail
# CUSTOM_DOMAIN=mail.crazychaos.top
# DOMAIN=["crazychaos.top"]
# TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
# LINUXDO_CLIENT_ID=your_linuxdo_client_id
# LINUXDO_CLIENT_SECRET=your_linuxdo_client_secret
# LINUXDO_CALLBACK_URL=your_linuxdo_callback_url
# LINUXDO_SWITCH=true
